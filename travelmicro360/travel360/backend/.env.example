# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is gitignored and must NEVER be committed.
#
# These vars feed the Spring services via ${VAR:default} placeholders in
# each service's application.properties and the config-server yml files.
# start-all.bat loads this file automatically. For IDE runs (IntelliJ),
# set the same variables in your Run Configuration's Environment, or set
# them as OS user environment variables so every run inherits them.

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your-mysql-password

# --- JWT signing key (must be >= 32 bytes; identical across all services) ---
# Generate a strong one, e.g.:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-min-32-bytes
